
# set_global_assignment -name FAMILY "Cyclone V"
# set_global_assignment -name DEVICE 5CGXFC4C7F27C8
source family_device.qsf
set_global_assignment -name ORIGINAL_QUARTUS_VERSION 17.0.0
set_global_assignment -name LAST_QUARTUS_VERSION "25.1std.0 Standard Edition"

set_global_assignment -name TOP_LEVEL_ENTITY main
set_global_assignment -name PROJECT_OUTPUT_DIRECTORY OUTPUT
set_global_assignment -name NUM_PARALLEL_PROCESSORS ALL
set_global_assignment -name FITTER_EFFORT "STANDARD FIT"


set_global_assignment -name PARTITION_NETLIST_TYPE SOURCE -section_id Top
set_global_assignment -name PARTITION_FITTER_PRESERVATION_LEVEL PLACEMENT_AND_ROUTING -section_id Top
set_global_assignment -name PARTITION_COLOR 16764057 -section_id Top


set_global_assignment -name SYSTEMVERILOG_FILE scr1_cg.sv
set_global_assignment -name SYSTEMVERILOG_FILE scr1_clk_ctrl.sv
set_global_assignment -name SYSTEMVERILOG_FILE scr1_core_top.sv
set_global_assignment -name SYSTEMVERILOG_FILE scr1_dmi.sv
set_global_assignment -name SYSTEMVERILOG_FILE scr1_dm.sv
set_global_assignment -name SYSTEMVERILOG_FILE scr1_dp_memory.sv
set_global_assignment -name SYSTEMVERILOG_FILE scr1_ipic.sv
set_global_assignment -name SYSTEMVERILOG_FILE scr1_mem_axi.sv
set_global_assignment -name SYSTEMVERILOG_FILE scr1_pipe_csr.sv
set_global_assignment -name SYSTEMVERILOG_FILE scr1_pipe_exu.sv
set_global_assignment -name SYSTEMVERILOG_FILE scr1_pipe_hdu.sv
set_global_assignment -name SYSTEMVERILOG_FILE scr1_pipe_ialu.sv
set_global_assignment -name SYSTEMVERILOG_FILE scr1_pipe_idu.sv
set_global_assignment -name SYSTEMVERILOG_FILE scr1_pipe_ifu.sv
set_global_assignment -name SYSTEMVERILOG_FILE scr1_pipe_lsu.sv
set_global_assignment -name SYSTEMVERILOG_FILE scr1_pipe_mprf.sv
set_global_assignment -name SYSTEMVERILOG_FILE scr1_pipe_tdu.sv
set_global_assignment -name SYSTEMVERILOG_FILE scr1_pipe_top.sv
set_global_assignment -name SYSTEMVERILOG_FILE scr1_reset_cells.sv
set_global_assignment -name SYSTEMVERILOG_FILE scr1_scu.sv
set_global_assignment -name SYSTEMVERILOG_FILE scr1_tapc_shift_reg.sv
set_global_assignment -name SYSTEMVERILOG_FILE scr1_tapc.sv
set_global_assignment -name SYSTEMVERILOG_FILE scr1_tapc_synchronizer.sv
set_global_assignment -name SYSTEMVERILOG_FILE main.sv
set_global_assignment -name SYSTEMVERILOG_FILE test.sv
set_global_assignment -name SDC_FILE main.sdc
